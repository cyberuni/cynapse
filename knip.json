{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		"packages/cynapse": {
			"project": ["src/**/*.ts"]
		},
		"apps/web": {
			"entry": ["src/**/*.{astro,ts,mdx}"],
			"project": ["src/**/*.{astro,ts,mdx}"]
		},
		"apps/cortex": {
			"entry": ["scripts/*.ts"],
			"project": ["src/**/*.{ts,tsx}", "scripts/*.ts"]
		}
	}
}
