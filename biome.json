{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"files": {
		"includes": [
			"!**/dist",
			"!**/node_modules",
			"!**/.turbo",
			"!skills-lock.json",
			"!.agents",
			"!**/.astro",
			"!.cyberfleet",
			"!.claude/worktrees"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/cynapse/src/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": {
							"level": "error",
							"options": {
								"allow": ["log", "info", "warn", "error"]
							}
						}
					}
				}
			}
		}
	]
}
