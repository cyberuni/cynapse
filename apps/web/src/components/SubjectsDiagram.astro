---
// Channels keyed by subject (ADR-0010 to ADR-0012): subjects live in their own stores, each
// keys one channel in cynapse, and relations stay on the subjects. Static inline SVG; see
// diagram.css.
import './diagram.css'

const rows = [
	{
		y: 60,
		subject: 'cyberuni/cynapse',
		subjectNote: 'a repository',
		channel: 'gh:cyberuni/cynapse',
		kind: 'ADDRESS CHANNEL',
		owner: 'owner: the repository’s owner',
	},
	{
		y: 140,
		subject: 'issue #12',
		subjectNote: 'closed-by: #15',
		channel: 'gh:cyberuni/cynapse#12',
		kind: 'WORK CHANNEL',
		owner: 'members, no owner',
	},
	{
		y: 220,
		subject: 'PR #15',
		subjectNote: 'closes: #12',
		channel: 'gh:cyberuni/cynapse#15',
		kind: 'WORK CHANNEL',
		owner: 'members, no owner',
	},
]
---

<figure class="cynapse-diagram not-content">
	<svg viewBox="0 0 760 400" role="img" aria-labelledby="subjects-title subjects-desc">
		<title id="subjects-title">Channels keyed by subject</title>
		<desc id="subjects-desc">
			In GitHub, the repository cyberuni/cynapse, issue 12 and PR 15 are subjects. The
			relation "PR 15 closes issue 12" is recorded on both subjects. In cynapse, each subject
			keys one channel by UUIDv5 of its native ID: the repository an address channel with an
			owner, the issue and the PR a work channel each, with members and no owner. A
			participant registered by the runtime, the reviewer, keys an address channel too.
		</desc>
		<defs>
			<marker id="subjects-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 10 5 0 10z" class="head" />
			</marker>
			<marker id="subjects-arrow-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 10 5 0 10z" class="head muted" />
			</marker>
		</defs>

		<rect class="box dashed" x="20" y="20" width="300" height="270" rx="10" />
		<text class="layer" x="36" y="44">GITHUB (THE SUBJECTS’ STORE)</text>
		<rect class="box dashed" x="440" y="20" width="300" height="360" rx="10" />
		<text class="layer" x="456" y="44">CYNAPSE</text>

		{rows.map((r) => (
			<g>
				<rect class="box" x="40" y={r.y} width="260" height="56" rx="6" />
				<text class="name" x="56" y={r.y + 24}>{r.subject}</text>
				<text class="note" x="56" y={r.y + 44}>{r.subjectNote}</text>
				<rect class={r.kind === 'ADDRESS CHANNEL' ? 'box accent' : 'box'} x="460" y={r.y} width="260" height="56" rx="6" />
				<text class="layer" x="476" y={r.y + 18}>{r.kind}</text>
				<text class="name" x="476" y={r.y + 36}>{r.channel}</text>
				<text class="note" x="476" y={r.y + 51}>{r.owner}</text>
				<line class="edge" x1="300" y1={r.y + 28} x2="458" y2={r.y + 28} marker-end="url(#subjects-arrow)" />
			</g>
		))}
		<text class="edge-label" x="380" y="80" text-anchor="middle">keys</text>
		<text class="edge-label" x="380" y="128" text-anchor="middle">UUIDv5(native ID)</text>

		<line class="edge dashed" x1="120" y1="196" x2="120" y2="218" marker-start="url(#subjects-arrow-muted)" marker-end="url(#subjects-arrow-muted)" />
		<text class="edge-label" x="128" y="211">relation, on both ends</text>

		<rect class="box" x="40" y="310" width="260" height="56" rx="6" />
		<text class="layer" x="56" y="328">RUNTIME REGISTERS</text>
		<text class="name" x="56" y="348">participant reviewer</text>
		<text class="note" x="56" y="362">key cyberlegion:role/reviewer</text>
		<rect class="box accent" x="460" y="310" width="260" height="56" rx="6" />
		<text class="layer" x="476" y="328">ADDRESS CHANNEL</text>
		<text class="name" x="476" y="346">reviewer</text>
		<text class="note" x="476" y="361">owner: the participant</text>
		<line class="edge" x1="300" y1="338" x2="458" y2="338" marker-end="url(#subjects-arrow)" />
	</svg>
	<figcaption>
		Address channels (outlined in the accent color) take direct messages; work channels hold
		the conversation about one piece of work. The readable reference is a handle, not the key,
		because it changes when a subject moves. Accepted (ADR-0012) and proposed (ADR-0013), not
		built.
	</figcaption>
</figure>
