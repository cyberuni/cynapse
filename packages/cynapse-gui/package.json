{
	"name": "@cyberuni/cynapse-gui",
	"version": "0.1.0",
	"description": "The Council's web viewer for cynapse channels, started by `cynapse gui`",
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/cynapse.git",
		"directory": "packages/cynapse-gui"
	},
	"author": "unional <homawong@gmail.com>",
	"license": "MIT",
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsdown && vite build",
		"dev": "vite",
		"start": "tsx src/server/main.ts",
		"test": "vitest run src",
		"typecheck": "tsc --noEmit",
		"screenshots": "tsx scripts/screenshots.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"hono": "^4.13.10"
	},
	"peerDependencies": {
		"cynapse": "*"
	},
	"devDependencies": {
		"@types/node": "^25.9.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"cynapse": "workspace:*",
		"playwright": "^1.63.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22.13"
	}
}
