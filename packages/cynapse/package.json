{
	"name": "cynapse",
	"version": "0.2.0",
	"description": "A persisted communication network for agents — channels of immutable entries",
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/cynapse.git"
	},
	"author": "unional <homawong@gmail.com>",
	"license": "MIT",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"skills",
		"plugin.json",
		".claude-plugin",
		".cursor-plugin",
		".codex-plugin"
	],
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./refs": {
			"import": "./dist/refs.js",
			"types": "./dist/refs.d.ts"
		},
		"./sqlite-warning": {
			"import": "./dist/sqlite-warning.js",
			"types": "./dist/sqlite-warning.d.ts"
		}
	},
	"bin": {
		"cynapse": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsdown",
		"cynapse": "tsx src/cli.ts",
		"dev": "tsx src/cli.ts",
		"format": "biome format --write .",
		"test": "vitest run src",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.8",
		"typescript": "^7.0.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22.13"
	}
}
